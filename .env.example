# Copia este archivo a .env.local y completa los valores desde Supabase.
# La anon/publishable key puede estar en el frontend SOLO si activas RLS y políticas seguras.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_PUBLISHABLE_O_ANON_KEY
# URL de tu Edge Function para resúmenes (no incluyas ninguna clave secreta aquí).
VITE_SUMMARY_FUNCTION_URL=https://TU-PROYECTO.supabase.co/functions/v1/summarize-album
# Edge Function para URLs firmadas de álbumes compartidos (no es una clave secreta).
VITE_SHARED_PHOTOS_FUNCTION_URL=https://TU-PROYECTO.supabase.co/functions/v1/shared-album-photos
